# ── Required in production ────────────────────────────────────────────────
# Public URL Vigil is served from (used for OAuth redirects + email links)
APP_URL=https://vigil.digitaltreasury.com.au

# Random secret for signing session cookies:  openssl rand -hex 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Web application).
# Authorised redirect URI:  ${APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace domain allowed to sign in
ALLOWED_EMAIL_DOMAIN=digitaltreasury.com.au

# ── Email notifications (optional — runs work without it, no emails sent) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set SMTP_SECURE=1 for port 465 (implicit TLS)
SMTP_SECURE=

# ── Local development only ─────────────────────────────────────────────────
# Skip Google sign-in entirely (NEVER set in production)
# DEV_AUTH_BYPASS=1
# Point at a specific Chromium binary if Playwright's own isn't installed
# CHROMIUM_PATH=/usr/bin/chromium

# Note: the Anthropic API key is NOT set here — add it in the app under
# Settings → Anthropic API key (stored in the database, masked in the UI).
