# ─────────────────────────────────────────────────────────────────────────────
# Vigil — environment configuration (copy to .env and fill in)
# Secrets live here, never in the repo. Anthropic key + assessment model live in
# the DB Settings (set via the UI), NOT here — so the team manages them without a
# redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
# Public base URL of the app (used for deep links in emails). Local: http://localhost:3000
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Australia/Melbourne

# --- Database (in-stack Postgres) ---
# In docker-compose the host is `postgres`; on host dev it's `localhost`.
DATABASE_URL=postgresql://vigil:vigil@localhost:5432/vigil?schema=public
POSTGRES_USER=vigil
POSTGRES_PASSWORD=vigil
POSTGRES_DB=vigil

# --- Redis (BullMQ) ---
# In docker-compose the host is `redis`; on host dev it's `localhost`.
REDIS_URL=redis://localhost:6379

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Workspace domain sign-in is restricted to (server-side enforced).
ALLOWED_EMAIL_DOMAIN=digitaltreasury.com.au

# --- Encryption (Anthropic key at rest) ---
# 32-byte key, hex or base64. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Storage driver ---
# local | s3
STORAGE_DRIVER=local
# LocalDriver: absolute or relative path the worker + app can both read/write.
STORAGE_LOCAL_PATH=./storage-data
# S3Driver (Cloudflare R2 etc.) — only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Seconds a signed GET URL stays valid
SIGNED_URL_TTL=300

# --- Email (Resend) ---
RESEND_API_KEY=
NOTIFY_FROM="Vigil <vigil@digitaltreasury.com.au>"

# --- Capture worker tuning ---
SCREENSHOT_CONCURRENCY=3
LIGHTHOUSE_CONCURRENCY=1
CAPTURE_NAV_TIMEOUT_MS=45000
CAPTURE_SETTLE_MS=1000
# Max full-page screenshot height (device px) before clip-and-stitch fallback
SCREENSHOT_MAX_HEIGHT=15000

# --- Defaults (seed values for the Settings singleton on first boot) ---
DEFAULT_DIFF_THRESHOLD_PCT=1.0
DEFAULT_RETENTION_DAYS=90
DEFAULT_ASSESSMENT_MODEL=claude-sonnet-4-6
