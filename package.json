{
  "name": "vigil",
  "private": true,
  "version": "0.1.0",
  "description": "Vigil — internal visual & code regression testing tool for Digital Treasury",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:app": "pnpm --filter @vigil/app dev",
    "dev:worker": "pnpm --filter @vigil/worker dev",
    "build": "pnpm --filter @vigil/app build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @vigil/db generate",
    "db:migrate": "pnpm --filter @vigil/db migrate",
    "db:migrate:deploy": "pnpm --filter @vigil/db migrate:deploy",
    "db:studio": "pnpm --filter @vigil/db studio",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ],
    "overrides": {
      "ioredis": "^5.11.1"
    }
  }
}
